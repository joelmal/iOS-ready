{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iosready.local/schemas/snippet-challenge.schema.json",
  "title": "Snippet challenge",
  "description": "On-device coding challenge (master plan Sections 7.5, 16.1). Graded by deterministic structural checks plus AI review; optionally upgraded to compile evidence by the Mac runner. Needed by Milestone 3.",
  "type": "object",
  "required": ["id", "contentVersion", "competencyIds", "kind", "prompt", "starterCode",
               "language", "solutionCode", "solutionExplanation", "rubricVersion", "estimatedMinutes"],
  "properties": {
    "id": { "type": "string", "pattern": "^c\\.[a-z]+\\.[a-z]+\\.[a-zA-Z]+\\.[0-9]{3}$" },
    "contentVersion": { "type": "string" },
    "competencyIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "kind": { "type": "string", "enum": ["smallExercise", "finishTheCode", "findTheBug", "codeReview"] },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
    "prompt": { "type": "string" },
    "starterCode": { "type": "string" },
    "language": { "type": "string", "enum": ["swift"] },
    "requiredPatterns": { "type": "array", "items": {
      "type": "object", "required": ["pattern", "description"],
      "properties": { "pattern": { "type": "string" }, "description": { "type": "string" },
                      "weight": { "type": "number" } } } },
    "forbiddenPatterns": { "type": "array", "items": {
      "type": "object", "required": ["pattern", "description"],
      "properties": { "pattern": { "type": "string" }, "description": { "type": "string" } } } },
    "requiredSignatures": { "type": "array", "items": { "type": "string" } },
    "plantedIssues": { "type": "array", "items": {
      "type": "object", "required": ["id", "severity", "description", "competencyId"],
      "properties": { "id": { "type": "string" }, "line": { "type": "integer" },
                      "severity": { "type": "string", "enum": ["minor", "major", "critical"] },
                      "description": { "type": "string" }, "competencyId": { "type": "string" } } } },
    "hints": { "type": "array", "items": { "type": "string" },
      "description": "Revealed on request at a score cost." },
    "solutionCode": { "type": "string" },
    "solutionExplanation": { "type": "string" },
    "rubricVersion": { "type": "string" },
    "estimatedMinutes": { "type": "integer", "minimum": 1 }
  }
}
