{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iosready.local/schemas/behavioral-question.schema.json",
  "title": "Behavioral question",
  "description": "Question schema plus STAR guidance. Needed by Milestone 2. Master plan Sections 7.10, 19.3.",
  "type": "object",
  "required": ["id", "contentVersion", "themeId", "competencyIds", "prompt",
               "starGuidance", "strongSignals", "redFlags", "rubricVersion"],
  "properties": {
    "id": { "type": "string", "pattern": "^b\\.[a-z]+\\.[0-9]{3}$" },
    "contentVersion": { "type": "string" },
    "themeId": { "type": "string", "description": "e.g. behavioral.conflict" },
    "competencyIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "prompt": { "type": "string" },
    "targetAnswerSeconds": { "type": "integer", "minimum": 60, "maximum": 240 },
    "starGuidance": { "type": "object",
      "properties": { "situation": { "type": "string" }, "task": { "type": "string" },
                      "action": { "type": "string" }, "result": { "type": "string" } } },
    "strongSignals": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "redFlags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "followUpSeeds": { "type": "array", "items": { "type": "string" } },
    "rubricVersion": { "type": "string" }
  }
}
