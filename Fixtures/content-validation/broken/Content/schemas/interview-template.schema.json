{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iosready.local/schemas/interview-template.schema.json",
  "title": "Mock interview template",
  "description": "Shape of a simulated interview. Needed by Milestone 2. Master plan Sections 7.8, 19.3.",
  "type": "object",
  "required": ["id", "contentVersion", "title", "durationMinutes", "sections"],
  "properties": {
    "id": { "type": "string" },
    "contentVersion": { "type": "string" },
    "title": { "type": "string" },
    "format": { "type": "string", "enum": ["screen", "standard", "fullLoop"] },
    "durationMinutes": { "type": "integer", "minimum": 10 },
    "openingScript": { "type": "string" },
    "closingScript": { "type": "string" },
    "sections": { "type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["id", "title", "itemCount", "minutes", "followUpBudget"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "categoryIds": { "type": "array", "items": { "type": "string" } },
        "competencyIds": { "type": "array", "items": { "type": "string" } },
        "itemCount": { "type": "integer", "minimum": 1 },
        "minutes": { "type": "integer", "minimum": 1 },
        "followUpBudget": { "type": "integer", "minimum": 0, "maximum": 3 } } } }
  }
}
