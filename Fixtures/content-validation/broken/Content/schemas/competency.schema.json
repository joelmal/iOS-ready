{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iosready.local/schemas/competency.schema.json",
  "title": "Competency",
  "description": "A single testable skill. The join key for all content, evidence and scoring. Master plan Section 8.2.",
  "type": "object",
  "required": ["id", "category", "title", "summary", "importance", "interviewFrequency",
               "dimensionProfile", "isCore", "targetLevels", "prerequisites", "coverageTopics"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+\\.[a-zA-Z]+$" },
    "category": { "type": "string", "enum": ["swift", "fundamentals", "swiftui", "uikit",
      "networking", "concurrency", "architecture", "persistence", "testing", "debugging",
      "security", "frameworks", "workflow", "system", "behavioral", "resume"] },
    "title": { "type": "string" },
    "summary": { "type": "string", "description": "One sentence: what mastery means." },
    "importance": { "type": "integer", "minimum": 1, "maximum": 5 },
    "interviewFrequency": { "type": "string", "enum": ["rare", "occasional", "common", "nearCertain"] },
    "dimensionProfile": { "type": "string",
      "enum": ["balanced", "concept", "code", "diagnostic", "design", "narrative"] },
    "isCore": { "type": "boolean", "description": "Subject to the minimum-floor rule (11.6)." },
    "targetLevels": { "type": "array", "minItems": 1,
      "items": { "type": "string", "enum": ["foundation", "mid", "strongMid", "senior"] } },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "relatedCompetencies": { "type": "array", "items": { "type": "string" } },
    "coverageTopics": { "type": "array", "minItems": 1, "items": { "type": "string" },
      "description": "Sub-topics content must cover for this competency." },
    "mistakes": { "type": "array", "items": { "type": "string" } },
    "halfLifeDays": { "type": "integer", "minimum": 1,
      "description": "Overrides DEFAULT_HALF_LIFE_DAYS (45) for decay." }
  }
}
